{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(mvn test)",
            "PowerShell(mvn test)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(**/application-prod*.properties)"
        ]
    }
}